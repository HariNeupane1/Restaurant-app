// ============================================================
// MODELS
// ============================================================

class Food {
  final String name;
  final String category;
  final double price;
  final bool alcoholic;
  bool available;

  Food({
    required this.name,
    required this.category,
    required this.price,
    this.alcoholic = false,
    this.available = true,
  });
}

class CartItem {
  final Food food;
  int quantity;

  CartItem({
    required this.food,
    this.quantity = 1,
  });

  double get total => food.price * quantity;
}

class RestaurantOrder {
  final int id;
  final List<CartItem> items;
  final double total;
  final DateTime time;
  String status;
  String paymentMethod;

  RestaurantOrder({
    required this.id,
    required this.items,
    required this.total,
    required this.time,
    this.status = 'Pending',
    this.paymentMethod = 'Cash',
  });
}

class Expense {
  final String title;
  final double amount;
  final DateTime date;

  Expense({
    required this.title,
    required this.amount,
    required this.date,
  });
}

class StaffMember {
  final String name;
  final String role;
  bool present;

  StaffMember({
    required this.name,
    required this.role,
    this.present = false,
  });
}

