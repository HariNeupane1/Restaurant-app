  // ==========================================================
  // PLACE ORDER
  // ==========================================================

  void placeOrder() {
    if (cart.isEmpty) return;

    final copiedItems =
        cart.map(
      (item) {
        return CartItem(
          food: item.food,
          quantity: item.quantity,
        );
      },
    ).toList();

    final order =
        RestaurantOrder(
      id: 1001 + orders.length,
      items: copiedItems,
      total: cartTotal,
      time: DateTime.now(),
    );

    setState(() {
      orders.insert(0, order);
      cart.clear();
    });

    Navigator.pop(context);

    ScaffoldMessenger.of(context)
        .showSnackBar(
      SnackBar(
        content: Text(
          'Order #${order.id} created',
        ),
      ),
    );
  }

