  Widget kitchenCard(
    RestaurantOrder order,
  ) {
    return Card(
      margin:
          const EdgeInsets.only(
        bottom: 15,
      ),
      child: Padding(
        padding:
            const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment:
              CrossAxisAlignment
                  .start,
          children: [
            Row(
              mainAxisAlignment:
                  MainAxisAlignment
                      .spaceBetween,
              children: [
                Text(
                  'ORDER #${order.id}',
                  style:
                      const TextStyle(
                    fontSize: 20,
                    fontWeight:
                        FontWeight.bold,
                  ),
                ),
                Chip(
                  label:
                      Text(order.status),
                ),
              ],
            ),
            const Divider(),
            ...order.items.map(
              (item) {
                return ListTile(
                  contentPadding:
                      EdgeInsets.zero,
                  leading: Icon(
                    item.food
                            .alcoholic
                        ? Icons.local_bar
                        : Icons.restaurant,
                    color: item.food
                            .alcoholic
                        ? Colors.amber
                        : Colors.blue,
                  ),
                  title: Text(
                    item.food.name,
                  ),
                  trailing: Text(
                    'x ${item.quantity}',
                    style:
                        const TextStyle(
                      fontWeight:
                          FontWeight.bold,
                    ),
                  ),
                );
              },
            ),
            ElevatedButton(
              onPressed: () {
                setState(() {
                  if (order.status ==
                      'Pending') {
                    order.status =
                        'Preparing';
                  } else if (order.status ==
                      'Preparing') {
                    order.status =
                        'Ready';
                  } else {
                    order.status =
                        'Completed';
                  }
                });
              },
              child: Text(
                order.status ==
                        'Pending'
                    ? 'START PREPARING'
                    : order.status ==
                            'Preparing'
                        ? 'MARK READY'
                        : 'COMPLETE ORDER',
              ),
            ),
          ],
        ),
      ),
    );
  }

